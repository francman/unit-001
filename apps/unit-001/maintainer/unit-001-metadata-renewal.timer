# Runs independently of GitHub Actions; persistent catch-up still needs this host to be available.
[Unit]
Description=Keep unit-001 signed update metadata fresh

[Timer]
OnBootSec=10min
OnCalendar=*-*-* 00,12:00:00 UTC
RandomizedDelaySec=15min
Persistent=true
Unit=unit-001-metadata-renewal.service

[Install]
WantedBy=timers.target

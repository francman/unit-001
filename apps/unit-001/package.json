{
	"name": "unit-001",
	"version": "0.0.7",
	"description": "unit-001: a durable agent built on Pi Durable",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "npm --prefix ../../packages/unit-memory run build && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json",
		"release:build": "node scripts/build-release.mjs",
		"test:release": "node --test test/release.test.mjs",
		"test:management": "node --test test/management.test.mjs test/activation.test.mjs test/mission-management.test.mjs",
		"bench": "tsc -p bench/tsconfig.json && node --conditions=source --experimental-strip-types bench/checkpoint-commit.bench.ts && node --conditions=source --experimental-strip-types bench/request-preparation.bench.ts && node --conditions=source --experimental-strip-types bench/memory-recall.bench.ts && node --conditions=source --experimental-strip-types bench/memory-request.bench.ts",
		"test": "vitest --run",
		"start": "node dist/bin.js"
	},
	"keywords": [
		"agent",
		"durable-execution",
		"pi-durable"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0",
		"@tufjs/models": "4.1.1",
		"tuf-js": "5.0.1",
		"unit-memory": "0.0.1"
	},
	"devDependencies": {
		"shx": "0.3.4",
		"vitest": "4.1.12"
	}
}
